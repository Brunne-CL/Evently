# Evently API — copia este archivo a .env y ajusta según Laragon
PORT=4000
NODE_ENV=development

# MySQL (Laragon por defecto: root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=evently_db

# JWT — cambia esto en producción
JWT_SECRET=evently_dev_secret_cambia_esto_en_produccion_2026
JWT_EXPIRES_IN=8h

# CORS — origen(es) del frontend (coma = varios)
# Local:
CORS_ORIGIN=http://localhost:5173
# Producción (ejemplo):
# CORS_ORIGIN=https://evently-qro.vercel.app,http://localhost:5173

# Hash bcrypt (coste 12 recomendado)
BCRYPT_ROUNDS=12

# En la EC2, docker-compose pone redis://redis:6379.
# Si lo dejas vacío, el QR y el cierre de sesión viven solo en memoria.
# REDIS_URL=redis://127.0.0.1:6379
